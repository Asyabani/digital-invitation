# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Membuat sesi login dengan token yang bisa ditebak; lokal saja, jangan di-commit.
/scripts/demo.ts

# Artefak sementara proses desain: tangkapan layar review & komp.
