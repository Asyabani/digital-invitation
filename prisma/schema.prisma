// Skema database final — lihat docs/03-data-model.md
// Perubahan skema WAJIB memperbarui docs/03 lebih dulu.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum ────────────────────────────────────────────────────────────────

enum InvitationStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum Package {
  BASIC
  PREMIUM
  EXCLUSIVE
}

enum RsvpStatus {
  HADIR
  TIDAK_HADIR
  RAGU
}

enum GreetingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum GiftMethod {
  TRANSFER
  QRIS
}

enum Role {
  USER
  ADMIN
}

enum TemplateCategory {
  PERNIKAHAN
  AQIQAH
  ULANG_TAHUN
  KORPORAT
}

// ─── Auth.js (NextAuth) ──────────────────────────────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  role          Role         @default(USER)
  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  payments      Payment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain ──────────────────────────────────────────────────────────────

model Template {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  category        TemplateCategory
  previewImage    String
  defaultContent  Json
  defaultTheme    Json
  defaultSections Json
  isActive        Boolean          @default(true)
  invitations     Invitation[]
  createdAt       DateTime         @default(now())
}

model Invitation {
  id          String           @id @default(cuid())
  userId      String
  templateId  String
  slug        String           @unique
  title       String
  status      InvitationStatus @default(DRAFT)
  package     Package?
  activeUntil DateTime?
  publishedAt DateTime?

  content       Json
  themeConfig   Json
  sectionsOrder Json
  giftConfig    Json?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  Template           @relation(fields: [templateId], references: [id])
  guests    Guest[]
  rsvps     Rsvp[]
  greetings Greeting[]
  gifts     GiftConfirmation[]
  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Guest {
  id           String             @id @default(cuid())
  invitationId String
  name         String
  personalSlug String
  category     String?
  sentAt       DateTime?
  invitation   Invitation         @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  rsvps        Rsvp[]
  greetings    Greeting[]
  gifts        GiftConfirmation[]
  createdAt    DateTime           @default(now())

  @@unique([invitationId, personalSlug])
  @@index([invitationId])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  guestId      String?
  name         String
  status       RsvpStatus
  headcount    Int        @default(1)
  message      String?
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Greeting {
  id           String         @id @default(cuid())
  invitationId String
  guestId      String?
  name         String
  message      String
  status       GreetingStatus @default(PENDING)
  invitation   Invitation     @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?         @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())

  @@index([invitationId, status])
}

model GiftConfirmation {
  id           String     @id @default(cuid())
  invitationId String
  guestId      String?
  name         String
  method       GiftMethod
  amount       Int?
  proofUrl     String?
  note         String?
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([invitationId])
}

model Payment {
  id           String        @id @default(cuid())
  invitationId String
  userId       String
  provider     String        @default("xendit")
  externalId   String        @unique
  amount       Int
  package      Package
  status       PaymentStatus @default(PENDING)
  invoiceUrl   String?
  paidAt       DateTime?
  raw          Json?
  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([invitationId])
  @@index([status])
}
