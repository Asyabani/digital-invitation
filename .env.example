# --- Database ---
# Dev lokal (docker-compose). Produksi: connection string Neon.
DATABASE_URL="postgresql://user:pass@localhost:5435/undangan?schema=public"

# --- Auth.js (NextAuth) ---
# Generate: pnpm dlx auth secret
AUTH_SECRET=""
# Wajib saat menjalankan build produksi di luar Vercel (mis. `pnpm start` lokal
# atau self-host). Tanpa ini Auth.js menolak host dengan error UntrustedHost.
# Di Vercel tidak perlu diisi — host terdeteksi otomatis.
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic link (opsional, provider Resend)
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="Undangan Digital <noreply@example.com>"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Xendit (gunakan test key saat dev) ---
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# --- Cron (Vercel Cron) ---
# Dipakai endpoint /api/cron/expire-invitations. Wajib di Production.
CRON_SECRET=""

# --- Admin ---
# Opsional. Saat `pnpm db:seed`, akun dengan email ini diangkat jadi ADMIN.
# Akunnya harus sudah pernah masuk lebih dulu — seed tidak membuat user baru.
# Setelah ada satu admin, admin berikutnya diangkat dari /admin/pengguna.
SEED_ADMIN_EMAIL=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
